# Copy this file to .env and fill in. NEVER commit .env.
T212_API_KEY=your_key_here
T212_API_SECRET=your_secret_here   # leave blank if your key is the older single-token style

# demo | live   -- keep this on demo
T212_ENVIRONMENT=demo

# Must be exactly "true" to permit real-money order placement.
T212_ALLOW_LIVE=false
